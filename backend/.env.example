PORT=4000
NODE_ENV=development
# Set a unique random value with at least 32 bytes in production.
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=8h
OCR_THRESHOLD=75
OCR_LANGUAGES=eng+hin
# Set to the mount path when using persistent storage for uploaded documents.
DOCUMENT_STORAGE_DIR=
# Optional Gemini structured extraction of backend OCR text. Use synthetic,
# non-sensitive documents with the unpaid/free tier; Google may use submitted
# text to improve services and human reviewers may process it.
DOCUMENT_EXTRACTION_PROVIDER=tesseract
DOCUMENT_EXTRACTION_TIMEOUT_MS=15000
DOCUMENT_EXTRACTION_FALLBACK_TO_TESSERACT=true
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
MONGODB_URI=mongodb://127.0.0.1:27017/hackbios
# Use a separate database for integration tests; never point this at production.
MONGODB_TEST_URI=mongodb://127.0.0.1:27017/hackbios_auth_test
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173,https://e-governance-ai-powered.netlify.app
ADMIN_EMAIL=adminG@gmail.com
ADMIN_PASSWORD=admin12345678
MAX_UPLOAD_SIZE_BYTES=10485760
MAX_PDF_PAGES=10
AI_CLASSIFICATION_API_URL=
AI_CLASSIFICATION_API_KEY=
AI_CLASSIFICATION_MODEL=
AI_CLASSIFICATION_TIMEOUT_MS=15000
OCR_QUALITY_HARD_MINIMUM=50
OCR_QUALITY_MODERATE_FLOOR=60
OCR_AUTOMATION_MIN_TEXT_LENGTH=80
OCR_QUALITY_MIN_TEXT_LENGTH=30
OCR_QUALITY_MIN_WORD_COUNT=4
OCR_QUALITY_MIN_SCORE=0.85
OCR_QUALITY_STRONG_SCORE=0.95
OCR_QUALITY_MIN_COMPLETENESS=0.8
OCR_QUALITY_STRONG_COMPLETENESS=0.95
OCR_QUALITY_MAX_NOISE=0.2
OCR_QUALITY_STRONG_MAX_NOISE=0.05
AI_CLASSIFICATION_MIN_CONFIDENCE=0.9
AI_CRITICAL_FIELD_MIN_CONFIDENCE=0.95
# Optional chatbot model override. By default the chatbot reuses the
# classification model and API key when the classification endpoint is Groq.
# GROQ_MODEL=llama-3.3-70b-versatile
